# ────────────────────────────────────────────────────────────
# Proplux: Environment Configuration
# Copy this file to .env and fill in the values.
# NEVER commit .env to git.
# ────────────────────────────────────────────────────────────

# Database
# Any PostgreSQL (Neon, Supabase, RDS, or a VPS Postgres). On Vercel the
# Storage tab creates one and publishes DATABASE_URL for you.
# Local example: postgresql://user:password@localhost:5432/proplux
DATABASE_URL=""

# NextAuth: generates session tokens
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Trust the request host (needed behind any proxy or domain, which is the
# normal case for cPanel, VPS panels and Vercel)
AUTH_TRUST_HOST=true

# Encrypts hidden credential fields at rest (required)
# Generate with: openssl rand -base64 32. Keep the same value across deploys,
# or existing stored credentials become unreadable.
ENCRYPTION_KEY=""

# Public site URL (required in production; used for payment callbacks)
# e.g. https://yourdomain.com
NEXT_PUBLIC_APP_URL=""

# Canonical app URL in production (same value as NEXT_PUBLIC_APP_URL)
# AUTH_URL="https://yourdomain.com"

# Optional: uploads on Vercel Blob. Leave empty on a normal server and files
# are stored on disk in ./uploads instead (must be a persistent directory).
# BLOB_READ_WRITE_TOKEN=""

# Crypto payments: configure NOWPayments in Admin -> Payments
# (API key, IPN secret, sandbox toggle; stored in the DB, not here)

# Optional: email notifications
# Preferred: configure SMTP in Admin -> Settings -> Email (SMTP) (stored in DB).
# Fallback (used only when SMTP is off): Resend
# RESEND_API_KEY=""
# EMAIL_FROM="Proplux <no-reply@yourdomain.com>"
