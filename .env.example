# ────────────────────────────────────────────────────────────
# Proplux — Environment Configuration
# Copy this file to .env and fill in the values.
# NEVER commit .env to git.
# ────────────────────────────────────────────────────────────

# Database
# PostgreSQL. On Vercel: created in the Storage tab, then `npx vercel env pull`
# fills DATABASE_URL into .env.local for local development.
# Local equivalent: postgresql://user:password@localhost:5432/proplux
DATABASE_URL=""

# NextAuth — generates session tokens
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Required for deployment (Vercel, cPanel, etc.)
# Set to "true" unless you're behind a custom domain
AUTH_TRUST_HOST=true

# Encrypts hidden credential fields at rest (required)
# Generate with: openssl rand -base64 32 — keep the same value across deploys
ENCRYPTION_KEY=""

# Public site URL (required in production — used for payment callbacks)
# e.g. https://yourdomain.com
NEXT_PUBLIC_APP_URL=""

# Canonical app URL in production (same value as NEXT_PUBLIC_APP_URL)
# AUTH_URL="https://yourdomain.com"

# Crypto payments: configure NOWPayments in Admin → Payments
# (API key, IPN secret, sandbox toggle — stored in the DB, not here)

# Optional: email notifications
# Preferred: configure SMTP in Admin → Settings → Email (SMTP) (stored in DB).
# Fallback (used only when SMTP is off): Resend
# RESEND_API_KEY=""
# EMAIL_FROM="Proplux <no-reply@yourdomain.com>"
